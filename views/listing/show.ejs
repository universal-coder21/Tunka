<!-- views/listing/show.ejs -->
<% layout("/layouts/boilerplate") %>
  <style>
    .svg-wrapper, .shape, .text{
      display: none;
    }
    @media screen and (min-width: 1027px) {
      .svg-wrapper, .shape, .text{
      display: block;
    }
    
    .svg-wrapper {
      position: absolute;
        /* top: 50%; */
        right: 15px;
        /* bottom: 0; */
        bottom: -1379px;
        transform: translateY(-50%);
        margin: 0 auto;
        width: 320px;
    }

    .shape {
      stroke-dasharray: 140 540;
      stroke-dashoffset: -474;
      stroke-width: 8px;
      fill: transparent;
      stroke: #19f6e8;
      border-bottom: 5px solid black;
      transition: stroke-width 1s, stroke-dashoffset 1s, stroke-dasharray 1s;
    }

    .text {
      font-family: 'Roboto Condensed';
      font-size: 22px;
      line-height: 32px;
      letter-spacing: 8px;
      color: #080606;
      text-align: center;
      top: -48px;
      position: relative;
      pointer-events: none;
    }

    .shape:hover {
      stroke-width: 2px;
      stroke-dashoffset: 0;
      stroke-dasharray: 760;
    }

  }
  </style>
  <script>
    const mapToken = "<%= process.env.MAP_TOKEN%>";
    const coordinates = <% - JSON.stringify(listing.geometry.coordinates) %>;
  </script>

  <div class="container mt-4">
    <div class="row">
      <!-- Main Content Column -->
      <div class="col-lg-8">
        <!-- Listing Title -->
        <h1 class="mb-3  fw-bold listing-title">
          <%= listing.title %>
        </h1>

        <!-- Listing Images Gallery -->
        <div class="listing-gallery mb-4">
          <div class="row g-2">
            <div class="col-md-8">
              <img src="<%= listing.image.url %>" class="img-fluid main-image rounded shadow-sm"
                alt="<%= listing.title %>">
            </div>
            <div class="col-md-4 d-none d-md-block">
              <img src="<%= listing.image.url %>" class="img-fluid secondary-image rounded shadow-sm mb-2"
                alt="<%= listing.title %>">
              <img src="<%= listing.image.url %>" class="img-fluid secondary-image rounded shadow-sm"
                alt="<%= listing.title %>">
            </div>
          </div>
        </div>

        <!-- Listing Details -->
        <div class="card mb-4 listing-details ">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="card-title mb-0">
                <i class="bi bi-person-circle me-2"></i>Hosted by <b>
                  <%= listing.owner.username %>
                </b>
              </h5>
              <span class="badge bg-custom">
                <%= listing.country %>
              </span>
            </div>

            <p class="card-text listing-description">
              <%= listing.description %>
            </p>

            <div class="d-flex justify-content-between align-items-center mt-3">
              <h4 class="price-tag " style="color: #00FF00;">₹ <%= listing.price.toLocaleString("en-IN") %>
              </h4>
              <small class="text-muted location-text"><i class="bi bi-geo-alt"></i> <b>
                  <%= listing.location %>
                </b></small>
            </div>
          </div>
        </div>

        <!-- Owner Actions -->
        <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
          <div class="mb-4 owner-actions">
            <div class="d-flex gap-2">
              <a href="/listing/<%= listing._id %>/edit" class="">


                <button class="btn btn-custom-edit">
                  <i class="bi bi-pencil me-1"></i> Delete Listing
                </button>
              </a>
              <form method="post" action="/listing/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-custom-delete delete-btn">
                  <i class="bi bi-trash me-1"></i> Delete Listing
                </button>
              </form>
            </div>
          </div>
          <% } %>

            <!-- Map Section -->
            <div class="mb-4 map-container">
              <h3 class="section-title">Where you'll be</h3>

              <div id="map" class="rounded "></div>
            </div>

            <!-- Reviews Section -->
            <div class="mt-5 reviews-section" style="position: relative;">
              <h3 class="mb-4 border-bottom pb-2 section-title">Reviews & Ratings</h3>

              <!-- Add Review Form -->
              <% if (currUser) { %>
                <div class="card mb-4  review-form-card">
                  <div class="card-body p-4">
                    <h5 class="card-title mb-3">Leave a Review</h5>
                    <form action="/listing/<%= listing._id %>/reviews" method="POST" class="needs-validation"
                      novalidate>
                      <div class="mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                            aria-label="No rating." />
                          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                          <label for="first-rate1" title="Terrible">1 star</label>
                          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                          <label for="first-rate2" title="Not good">2 stars</label>
                          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                          <label for="first-rate3" title="Average">3 stars</label>
                          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                          <label for="first-rate4" title="Very good">4 stars</label>
                          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                          <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                      </div>

                      <div class="mb-3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea id="comment" name="review[comment]" rows="3" class="form-control"
                          placeholder="Share your experience..." required></textarea>
                        <div class="invalid-feedback">Please add a comment</div>
                      </div>

                      <button type="submit" class="btn btn-custom-submit">
                        <i class="bi bi-star me-1"></i> Submit Review
                      </button>
                    </form>
                  </div>
                </div>
                <% } %>

            </div>

            <div class="svg-wrapper">
              <svg height="60" width="320" xmlns="http://www.w3.org/2000/svg">
                <rect class="shape" height="60" width="320" />
                <div class="text">S.Das</div>
              </svg>
            </div>
      </div>

      <!-- Sidebar Column -->
      <div class="col-lg-4">
        <div class="position-sticky sidebar-sticky">
          <!-- Quick Info Card -->
          <div class="card  mb-4 booking-card">
            <div class="card-body p-4">
              <h4 class="card-title price-tag" style="color: #00FF00;">₹ <%= listing.price.toLocaleString("en-IN") %>
              </h4>
              <h6 class="card-subtitle mb-3 text-muted location-text"><i class="bi bi-geo-alt me-1"></i>
                <%= listing.location %>, <%= listing.country %>
              </h6>

              <!-- Call-to-action buttons -->
              <div class="d-grid gap-2">
                <button class="btn btn-custom-cta-primary">
                  <i class="bi bi-calendar-check me-1"></i> Check Availability
                </button>
                <button class="btn btn-custom-cta-secondary">
                  <i class="bi bi-bookmark me-1"></i> Save to Wishlist
                </button>
              </div>

              <!-- Listing highlights -->
              <hr>
              <h6 class="mb-3">Listing Highlights</h6>
              <ul class="list-unstyled highlight-list">
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Verified Host</li>
                <li class="mb-2"><i class="bi bi-star-fill text-warning me-2"></i>
                  <% if(listing.reviews.length> 0) { %>
                    <%= Math.round(listing.reviews.reduce((sum, review)=> sum + review.rating, 0) /
                      listing.reviews.length * 10) / 10 %> Rating
                      <% } else { %>
                        New Listing
                        <% } %>
                </li>
                <li><i class="bi bi-shield-check text-primary me-2"></i> Secure Booking</li>
              </ul>

              <!-- Share options -->
              <hr>
              <h6 class="mb-3">Share this place</h6>
              <div class="d-flex share-buttons">
                <!-- WhatsApp -->
                <a href="" onclick="shareOnWhatsApp()" class="btn btn-sm btn-outline-secondary me-2"
                  title="Share on WhatsApp">
                  <i class="bi bi-whatsapp"></i>
                </a>

                <!-- Facebook -->
                <a href="" onclick="shareOnFacebook()" class="btn btn-sm btn-outline-secondary me-2"
                  title="Share on Facebook">
                  <i class="bi bi-facebook"></i>
                </a>

                <!-- Twitter -->
                <a href="" onclick="shareOnTwitter()" class="btn btn-sm btn-outline-secondary me-2"
                  title="Share on Twitter">
                  <i class="bi bi-twitter"></i>
                </a>


                <a href="https://www.instagram.com/" target="_blank" class="btn btn-sm btn-outline-secondary me-2"
                  title="Open Instagram">
                  <i class="bi bi-instagram"></i>
                </a>

                <!-- Copy Link -->
                <a href="" onclick="copyLink()" class="btn btn-sm btn-outline-secondary" title="Copy Link">
                  <i class="bi bi-link-45deg"></i>
                </a>
              </div>
            </div>
            <!-- Reviews List -->
            <% if(listing.reviews.length> 0) { %>
              <h5 class="mb-3 ms-3 review-count">
                <%= listing.reviews.length %> Review<%= listing.reviews.length> 1 ? 's' : '' %>
              </h5>
              <div class="row g-3 reviews-list">
                <% for(review of listing.reviews) { %>
                  <div class="col-md-6">
                    <div class="card h-100 shadow-sm review-card">
                      <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                          <h6 class="card-subtitle review-author"><i class="bi bi-person-circle me-1"></i>
                            <%= review.author.username %>
                          </h6>
                          <p class="starability-result mb-0" data-rating="<%= review.rating %>">
                            Rated: <%= review.rating %> stars
                          </p>
                        </div>
                        <p class="card-text review-comment">
                          <%= review.comment %>
                        </p>

                        <!-- Only show delete button if current user is the review author -->
                        <% if (currUser && review.author._id.equals(currUser._id)) { %>
                          <form class="mt-2" method="POST"
                            action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-custom-delete-review">
                              <i class="bi bi-trash me-1"></i> Delete
                            </button>
                          </form>
                          <% } %>
                      </div>
                    </div>
                  </div>
                  <% } %>
              </div>
              <% } else { %>
                <div class="alert alert-light m-0 mx-auto
          no-reviews-alert">
                  <i class="bi bi-info-circle me-2"></i> No reviews yet. Be the first to leave a review!
                </div>
                <% } %>
          </div>
        </div>
      </div>


    </div>
  </div>

  <script src="/js/map.js"></script>
  <script>
    const currentUrl = encodeURIComponent(window.location.href);
    const message = encodeURIComponent("Check this out: ");

    function shareOnWhatsApp() {
      const url = `https://wa.me/?text=${message}${currentUrl}`;
      window.open(url, '_blank');
    }

    function shareOnFacebook() {
      const url = `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`;
      window.open(url, '_blank');
    }

    function shareOnTwitter() {
      const url = `https://twitter.com/intent/tweet?text=${message}${currentUrl}`;
      window.open(url, '_blank');
    }

    function copyLink() {
      navigator.clipboard.writeText(window.location.href).then(() => {
        alert("Link copied to clipboard!");
      }, () => {
        alert("Failed to copy link.");
      });
    }
  </script>